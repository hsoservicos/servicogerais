# ═══════════════════════════════════════════════════════════════
# .env.example — Environment Variables (ServiceSaaS)
# ═══════════════════════════════════════════════════════════════
# Copie para .env e ajuste os valores

# ── Application ───────────────────────────────────────────
APP_ENV=development
APP_NAME=ServiceSaaS
DEBUG=true

# ── MySQL Database ────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=servicos_flex
MYSQL_USER=flex_user
MYSQL_PASSWORD=flex_pass

# ── Node.js API ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT (Altere em produção!) ─────────────────────────────
JWT_SECRET=change-me-in-production-use-64-char-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change-me-refresh-secret-32-char-min

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=*

# ── API Connection (PHP → Node) ───────────────────────────
API_BASE_URL=http://api:3000/api/v1

# ── Mercado Pago (Story 5.x) ──────────────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ── Security ──────────────────────────────────────────────
SESSION_SECRET=change-me-session-secret
ENCRYPTION_KEY=change-me-encryption-key
