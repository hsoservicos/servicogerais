# ═══════════════════════════════════════════════════════════════
# ServiceSaaS — Variáveis de Ambiente (copiar para .env)
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=flex_user
DB_PASSWORD=flex_pass
DB_NAME=servicos_flex

# ── JWT / Autenticação ────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-64-char-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change-me-refresh-secret

# ── CORS ──────────────────────────────────────────────────────
# Produção: https://meudominio.com,https://app.meudominio.com
# Desenvolvimento: * (aceita qualquer origem)
CORS_ORIGIN=*

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=5

# ── Mercado Pago ──────────────────────────────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=https://seudominio.com/api/v1/payments/webhook

# ── Email (SendGrid) ──────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@servicesaas.com
EMAIL_PROVIDER=log

# ── LGPD / Criptografia ───────────────────────────────────────
ENCRYPTION_KEY=change-me-to-a-32-char-min-key-for-aes-256

# ── Observabilidade ───────────────────────────────────────────
LOG_LEVEL=info
LOKI_URL=http://loki:3100

# ── Infra ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:8080
